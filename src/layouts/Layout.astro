---
interface Props {
    title: string;
    backHref?: string;
    backLabel?: string;
}

const { title, backHref, backLabel } = Astro.props;
---

<!doctype html>
<html lang="no">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@300;400;700&family=Poppins:wght@300;400;700&display=swap"
        />
        <link rel="preconnect" href="https://ik.imagekit.io" />
        <title>{title}</title>
    </head>
    <body>
        <header class="site-header">
            <a href="/" class="logo" aria-label="SoCentral – til forsiden">
                <img src="/logo.png" alt="SoCentral logo" class="logo-img" />
            </a>
            <a
                href="https://www.socentral.no/medlem"
                class="btn-member"
                aria-label="Gå til SoCentral sin side om medlemskap"
            >
                Bli medlem
            </a>
        </header>

        {
            backHref && (
                <div class="back-bar">
                    <a href={backHref} class="back-link">
                        {backLabel}
                    </a>
                </div>
            )
        }

        <main>
            <slot />
        </main>

        <footer class="site-footer">
            <a
                href="https://github.com/SoCentral/somembers"
                target="_blank"
                rel="noreferrer"
            >
                Source code at Github
            </a>
        </footer>
    </body>
</html>

<style is:global>
    *, *::before, *::after { box-sizing: border-box; }

    [hidden] { display: none !important; }

    body {
        background-color: rgb(225, 225, 219);
        padding: 25px;
        margin: 0;
        font-family: 'Poppins', ui-sans-serif, Arial, sans-serif;
    }

    a { color: inherit; }

    /* ── Header ─────────────────────────────────────────────── */
    .site-header {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        width: 100%;
    }

    .logo { margin-right: auto; display: block; }

    .logo-img { width: 8rem; display: block; }

    .btn-member {
        background-color: #2b6cb0;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 300;
        font-size: 1rem;
        padding: 0.5rem 1rem;
        border-radius: 0.25rem;
        text-decoration: none;
        white-space: nowrap;
    }

    /* ── Back bar (detail pages) ─────────────────────────────── */
    .back-bar {
        text-align: right;
        margin-top: 0.5rem;
    }

    .back-link {
        color: #1d4ed8;
        text-decoration: underline;
        font-size: 0.875rem;
        font-family: 'Poppins', sans-serif;
    }

    /* ── Page section (title + switch + search) ──────────────── */
    .page-section {
        width: 100%;
        margin-top: 5rem;
        margin-bottom: 2.5rem;
    }

    .page-section h1 {
        font-family: 'Poppins', sans-serif;
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1.375;
        margin: 0 0 1rem 0;
    }

    .page-switch {
        display: inline-block;
        font-family: 'Poppins', sans-serif;
        font-weight: 300;
        font-size: 0.875rem;
        background-color: #2d3748;
        color: #fff;
        border-radius: 0.25rem;
        padding: 0.25rem 0.5rem;
        margin-bottom: 1.5rem;
        text-decoration: none;
    }

    #search {
        display: block;
        font-family: 'Poppins', sans-serif;
        font-size: 0.875rem;
        width: 100%;
        border: 1px solid #a0aec0;
        border-radius: 0.25rem;
        padding: 0.5rem;
        color: #2d3748;
        background-color: #fff;
        outline: none;
        appearance: none;
        -webkit-appearance: none;
        margin-bottom: 1rem;
    }

    #search:focus { border-color: #1c4532; }

    /* ── Cards grid ──────────────────────────────────────────── */
    .cards {
        margin-top: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        grid-row-gap: 3rem;
        grid-column-gap: 1rem;
        justify-items: center;
        justify-content: space-evenly;
    }

    .card {
        width: 320px;
        display: block;
        text-decoration: none;
        color: inherit;
    }

    .card-img-wrap {
        height: 320px;
        width: 100%;
    }

    .card-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0.5rem;
        background-color: #fff;
        display: block;
    }

    .cards.teams .card-img-wrap img { object-fit: contain; }

    .card-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 0.5rem;
        background-color: #fff;
    }

    .card-name {
        display: block;
        font-family: 'Poppins', sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        margin-top: 0.75rem;
        margin-bottom: -0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-company {
        display: block;
        font-family: 'Poppins', sans-serif;
        font-size: 1rem;
        font-weight: 300;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── No results ──────────────────────────────────────────── */
    #no-results {
        margin-top: 2rem;
        font-family: 'Poppins', sans-serif;
        color: #374151;
    }

    /* ── Footer ──────────────────────────────────────────────── */
    .site-footer {
        margin-top: 1.5rem;
        text-align: center;
    }

    .site-footer a {
        color: #4a5568;
        font-weight: 300;
        font-family: 'Crimson Pro', serif;
        font-style: italic;
        font-size: 0.75rem;
        text-decoration: none;
    }

    /* ── Detail pages ────────────────────────────────────────── */
    .member-detail,
    .company-detail {
        width: 100%;
        margin-top: 2rem;
        margin-bottom: 2.5rem;
        font-family: 'Poppins', sans-serif;
    }

    .member-detail h1,
    .company-detail h1 {
        margin-top: 2.5rem;
        margin-bottom: 0;
        font-size: 2.25rem;
        font-weight: 700;
        line-height: 1.375;
    }

    .member-company {
        display: block;
        margin-top: 0.5rem;
        font-size: 1.25rem;
        font-weight: 300;
        text-decoration: underline;
    }

    .member-body,
    .company-body {
        display: flex;
        flex-direction: column;
        margin-top: 2rem;
    }

    .member-img {
        height: 320px;
        width: 320px;
        border-radius: 0.5rem;
        object-fit: cover;
        background-color: #fff;
        flex-shrink: 0;
    }

    .member-img-placeholder {
        height: 320px;
        width: 320px;
        border-radius: 0.5rem;
        background-color: #fff;
        flex-shrink: 0;
    }

    .company-img {
        height: 320px;
        width: 320px;
        border-radius: 0.5rem;
        object-fit: contain;
        background-color: #fff;
        flex-shrink: 0;
    }

    .company-img-placeholder {
        height: 320px;
        width: 320px;
        border-radius: 0.5rem;
        background-color: #fff;
        flex-shrink: 0;
    }

    .member-bio,
    .company-description {
        margin-top: 2rem;
        line-height: 1.625;
        font-size: 1.25rem;
        font-family: 'Crimson Pro', serif;
        font-weight: 300;
    }

    .member-contacts,
    .company-links {
        margin-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .contact-btn {
        display: inline-flex;
        align-items: center;
        background: transparent;
        color: #2d3748;
        font-weight: 600;
        padding: 0.5rem 1rem;
        border: 1px solid #2d3748;
        border-radius: 9999px;
        text-decoration: none;
    }

    .member-tags,
    .company-members {
        margin-top: 2rem;
    }

    .member-tags h3,
    .company-members h3 {
        font-size: 1.125rem;
        font-weight: 700;
        margin: 0 0 0.5rem 0;
    }

    .member-tags ul,
    .company-members ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .member-tags ul li {
        font-size: 0.875rem;
        background-color: #4a5568;
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
    }

    .company-members ul li a {
        display: inline-block;
        font-size: 0.875rem;
        background-color: #2b6cb0;
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        text-decoration: none;
    }

    /* ── Responsive (lg = 1024px) ────────────────────────────── */
    @media (min-width: 1024px) {
        .site-header {
            width: 60%;
            margin-left: auto;
            margin-right: auto;
        }

        .logo-img { width: 10rem; }

        .back-bar {
            width: 60%;
            margin-left: auto;
            margin-right: auto;
        }

        .page-section {
            width: 60%;
            margin-left: auto;
            margin-right: auto;
            margin-top: 2.5rem;
            margin-bottom: 2.5rem;
            text-align: center;
        }

        .page-section h1 { margin-bottom: 0.5rem; }

        #search {
            max-width: 16rem;
            margin-left: auto;
            margin-right: auto;
        }

        .member-detail,
        .company-detail {
            width: 60%;
            margin-left: auto;
            margin-right: auto;
        }

        .member-body,
        .company-body {
            flex-direction: row;
        }

        .member-bio,
        .company-description {
            margin-top: 0;
            padding-left: 1.25rem;
        }
    }
</style>
