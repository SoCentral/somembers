---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { imageAttrs } from "../lib/images";

const companies = await getCollection("teams");

// Kortene som er synlige uten aa scrolle lastes med en gang (ikke lazy),
// slik at det storste bildet (LCP) oppdages tidlig.
const EAGER_COUNT = 4;
---

<Layout title="Våre virksomheter – SoCentral">
  <section class="page-section">
    <h1>Våre virksomheter</h1>
    <a class="page-switch" href="/">Se medlemmer</a>
    <input
      id="search"
      type="search"
      placeholder="Søk"
      autocomplete="off"
      aria-label="Søk i oversikten over virksomheter"
    />
  </section>

  <section id="grid" class="cards teams">
    {
      companies.map((company, i) => (
        <a
          href={`/companies/${company.data.slug}`}
          class="card"
          data-name={company.data.name.toLowerCase()}
          aria-label={`Les mer om ${company.data.name}`}
        >
          <div class="card-img-wrap">
            <img
              {...imageAttrs(company.data.image, "contain")}
              alt={`Bilde av ${company.data.name}`}
              loading={i < EAGER_COUNT ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
            />
          </div>
          <span class="card-name">{company.data.name}</span>
        </a>
      ))
    }
  </section>

  <p id="no-results" hidden>Ingen treff.</p>
</Layout>

<script>
  const search = document.getElementById("search") as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>("#grid .card");
  const noResults = document.getElementById("no-results") as HTMLElement;

  search.addEventListener("input", () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const name = card.dataset.name ?? "";
      const match = !q || name.includes(q);
      card.hidden = !match;
      if (match) visible++;
    });

    noResults.hidden = visible > 0;
  });
</script>
