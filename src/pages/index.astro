---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const members = await getCollection("members");
---

<Layout title="Våre medlemmer – SoCentral">
  <section class="page-section">
    <h1>Våre medlemmer</h1>
    <a class="page-switch" href="/companies">Se virksomheter</a>
    <input
      id="search"
      type="search"
      placeholder="Søk"
      autocomplete="off"
      aria-label="Søk i medlemsoversikten"
    />
  </section>

  <section id="grid" class="cards">
    {
      members.map((member) => (
        <a
          href={`/members/${member.data.slug}`}
          class="card"
          data-name={member.data.name.toLowerCase()}
          data-company={(member.data.teamName ?? "").toLowerCase()}
          aria-label={`Les mer om ${member.data.name}`}
        >
          <div class="card-img-wrap">
            <img
              src={member.data.image ?? "https://cdn.prod.website-files.com/633d71ff5625100570e7e68c/68f8d711d95a532bded7c6c3_default.png"}
              alt={`Bilde av ${member.data.name}`}
              loading="lazy"
            />
          </div>
          <span class="card-name">{member.data.name}</span>
          {member.data.teamName && (
            <span class="card-company">{member.data.teamName}</span>
          )}
        </a>
      ))
    }
  </section>

  <p id="no-results" hidden>Ingen treff.</p>
</Layout>

<script>
  const search = document.getElementById("search") as HTMLInputElement;
  const cards = document.querySelectorAll<HTMLElement>("#grid .card");
  const noResults = document.getElementById("no-results") as HTMLElement;

  search.addEventListener("input", () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const name = card.dataset.name ?? "";
      const company = card.dataset.company ?? "";
      const match = !q || name.includes(q) || company.includes(q);
      card.hidden = !match;
      if (match) visible++;
    });

    noResults.hidden = visible > 0;
  });
</script>
